new file mode 100644
index 0000000..e838276
--- /dev/null
+++ b/src/styles/animations.css
@@ -0,0 +1,164 @@
+/*
+  Entrance animations, view transitions, and their reduced-motion
+  counterparts. Every animation defined here has a no-motion form.
+*/
+
+@layer utilities {
+  /*
+    Primary entrance animation used throughout the site.
+
+    Rebalanced from the original: the scale was doing most of the work at 0.94
+    and the travel almost none at 8px, which reads as a card inflating in place
+    rather than arriving. Reversed -- a barely-there scale change and a much
+    longer rise -- so the motion has a direction.
+
+    The overshoot curve is kept but softened. A back-out with a 1.56 overshoot
+    on a large card is a bounce, and a bounce on a page about disasters is the
+    wrong register; this one settles rather than springs.
+
+    Only `opacity` and `transform` are animated, deliberately. Those two are the
+    properties a browser can hand to the compositor and run off the main thread;
+    anything else -- a blur that clears, an animated box-shadow, a colour fade
+    on a large surface -- forces a repaint every frame. A third of this site's
+    likely audience is on mid-range Android over Pacific mobile data, and an
+    entrance animation that stutters is worse than one that is plain.
+
+    No `will-change` either. It is genuinely useful for an element about to
+    animate and genuinely costly on a dozen sections that finished animating
+    minutes ago, and CSS gives no way to clear it afterwards. Browsers already
+    promote compositor-friendly animations like this one without being asked.
+  */
+  @keyframes pop-in {
+    from {
+      opacity: 0;
+      transform: scale(0.985) translateY(18px);
+    }
+
+    to {
+      opacity: 1;
+      transform: scale(1) translateY(0);
+    }
+  }
+
+  .animate-pop-in {
+    animation: pop-in 620ms cubic-bezier(0.16, 0.84, 0.28, 1) both;
+  }
+
+  /*
+    The ring a link of the ripple chain emits as it comes into view, so the
+    chain reads as one thing propagating rather than five cards appearing.
+    Sized past its card and clipped by it, which is what makes the arc look
+    like part of a much larger circle passing through.
+  */
+  @keyframes ripple-out {
+    from {
+      opacity: 0.5;
+      transform: translate(-50%, -50%) scale(0.12);
+    }
+
+    to {
+      opacity: 0;
+      transform: translate(-50%, -50%) scale(1);
+    }
+  }
+
+  .ripple-ring {
+    position: absolute;
+    left: 0;
+    top: 50%;
+    width: 230%;
+    aspect-ratio: 1 / 1;
+    border: 1.5px solid rgb(var(--color-accent));
+    border-radius: 9999px;
+    opacity: 0;
+    pointer-events: none;
+    animation: ripple-out 1150ms cubic-bezier(0.19, 0.72, 0.3, 1) both;
+  }
+
+  /*
+    A second, later ring from the same origin. Real ripples arrive in a train,
+    not one at a time, and a single ring reads as a click feedback effect
+    rather than as something propagating outward through the chain. Drawn
+    fainter and slightly behind, so it supports the first rather than competing
+    with it.
+  */
+  .ripple-ring::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    border: 1px solid rgb(var(--color-accent));
+    border-radius: inherit;
+    opacity: 0.55;
+    animation: ripple-out 1150ms cubic-bezier(0.19, 0.72, 0.3, 1) 220ms both;
+  }
+
+  /*
+    The cyclone glyph on the storm journey map. Applied to a group inside the
+    one carrying the position, never the same one: a CSS transform here would
+    replace the translate that puts the storm on the track.
+  */
+  @keyframes cyclone-spin {
+    from {
+      transform: rotate(0deg);
+    }
+
+    to {
+      transform: rotate(360deg);
+    }
+  }
+
+  .cyclone-spin {
+    transform-box: fill-box;
+    transform-origin: center;
+    animation: cyclone-spin 8s linear infinite;
+  }
+
+  /*
+    Cross-chart highlight. Applied by useNationHighlight.jsx to every mark that
+    isn't the country being pointed at, on every chart on the page at once.
+    Opacity only -- nothing moves, nothing is redrawn, and the axes and
+    annotations keep full strength because they carry no nation class.
+  */
+  .nation-mark {
+    /*
+      Slightly slower on the way in than the way out is not possible with one
+      transition, so this splits the difference at 200ms with a curve that
+      leaves quickly and arrives gently -- dimming should feel like attention
+      moving, not like a light switch.
+    */
+    transition: opacity 200ms cubic-bezier(0.33, 0.9, 0.4, 1);
+  }
+
+  .nation-dimmed {
+    opacity: 0.14;
+  }
+
+  /*
+    A nation drawn for comparison rather than because the event reached it.
+    Deliberately far less aggressive than .nation-dimmed above: that one is a
+    transient hover state and is meant to get out of the way, while this is the
+    chart's resting appearance and the line still has to be readable. A country
+    the storm missed is the nearest thing this data has to a control, and
+    hiding it would throw that away.
+  */
+  .nation-unstruck {
+    opacity: 0.42;
+  }
+
+  /* Entrance animation for anchored tooltips. */
+  @keyframes tooltip-pop-in {
+    from {
+      opacity: 0;
+      transform: translate(-50%, -100%) scale(0.85);
+    }
+
+    to {
+      opacity: 1;
+      transform: translate(-50%, -100%) scale(1);
+    }
+  }
+
+  .animate-tooltip-pop-in {
+    animation: tooltip-pop-in 220ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
+  }
+}
diff --git a/src/styles/base.css b/src/styles/base.css
new file mode 100644
index 0000000..63310b4
--- /dev/null
+++ b/src/styles/base.css
@@ -0,0 +1,199 @@
+/*
+  Theme variables, typography roles and document-level base styles.
+  Shared text styles live here -- reuse them rather than adding new ones.
+*/
+
+@layer base {
+  /*
+    Hide the browser scrollbar. The canoe in the header is the scroll readout,
+    and two position indicators competing at the edges of the same page is one
+    too many.
+
+    Deliberate trade-off, recorded because it is a real cost and not a free win.
+    A scrollbar is an affordance as well as a readout: it can be grabbed and
+    dragged, and some people navigate long pages that way. Hiding it takes that
+    away, and nothing here gives it back.
+
+    What is NOT given up: the page still scrolls by wheel, trackpad, touch,
+    keyboard (arrows, Page Up/Down, Home/End, Space) and by find-in-page,
+    because `scrollbar-width: none` hides the control without changing the
+    scroll container. Only the drag gesture is lost.
+
+    Applied to the document, not to `*`. A blanket rule would also strip the
+    scrollbars from any internal scrolling region -- a long tooltip, an
+    overflowing table on a narrow screen -- where there is no canoe to replace
+    them and the content would simply look truncated.
+  */
+  html {
+    scrollbar-width: none; /* Firefox */
+    -ms-overflow-style: none; /* legacy Edge */
+  }
+
+  html::-webkit-scrollbar {
+    display: none; /* Chrome, Safari, Edge */
+  }
+
+  /*
+    Theme colors are defined as CSS variables so Tailwind utilities
+    automatically adapt to light and dark mode.
+  */
+  :root {
+    --color-ink: 36 51 58;
+    --color-sand: 250 247 240;
+    --color-panel: 241 234 220;
+    --color-surface: 255 255 255;
+
+    /*
+      A darkened ocean, for the one accent that has to carry small text: the
+      eyebrow line above each headline. The decorative ocean (#5B8FA3, used for
+      the wave and the map markers) only reaches ~2.9:1 on sand and can't hold
+      text. This reaches 5.4:1, and 8.1:1 for its dark-mode counterpart.
+    */
+    --color-accent: 61 107 125;
+  }
+
+  .dark {
+    --color-ink: 240 236 227;
+    --color-sand: 24 30 33;
+    --color-panel: 34 42 46;
+    --color-surface: 41 50 54;
+    --color-accent: 143 186 205;
+  }
+
+  /*
+    Updated by App.jsx to keep in-page navigation clear of the
+    fixed header.
+  */
+  html {
+    --header-height: 96px;
+    scroll-padding-top: calc(var(--header-height) + 16px);
+  }
+
+  @media (prefers-reduced-motion: no-preference) {
+    html {
+      scroll-behavior: smooth;
+    }
+  }
+
+  /*
+    Avoid single-word last lines in headings, and orphans in body text.
+    Unsupported browsers ignore both and wrap as before.
+  */
+  h1,
+  h2,
+  h3 {
+    text-wrap: balance;
+  }
+
+  p {
+    text-wrap: pretty;
+  }
+
+  body {
+    @apply bg-sand text-ink antialiased;
+
+    /* Prevent accidental horizontal scrolling. */
+    overflow-x: hidden;
+
+    /* Smooth theme transitions. */
+    transition:
+      background-color 200ms ease-out,
+      color 200ms ease-out;
+  }
+
+  /*
+  View Transitions. Ripple is a single page, so the only transition here is the
+  theme toggle's -- but the default root cross-fade is left defined rather than
+  disabled outright, so it's still correct if a second view is ever added.
+
+  The theme toggle wants the opposite: the outgoing page must sit still and
+  fully opaque underneath while the new theme is wiped over it by the expanding
+  circle in ThemeToggle.jsx. Cross-fading both layers at once would wash the
+  whole page out to grey halfway through. Scoped to the sweep class so it can't
+  affect navigation, and the z-index puts the new theme on top -- without it
+  the circle would be clipping a layer that's already behind.
+*/
+  html.theme-sweep::view-transition-old(root) {
+    animation: none;
+    z-index: 1;
+  }
+
+  html.theme-sweep::view-transition-new(root) {
+    animation: none;
+    z-index: 999;
+    mix-blend-mode: normal;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    /* The root cross-fade is decoration; the toggle already opts out in JS. */
+    ::view-transition-old(root),
+    ::view-transition-new(root) {
+      animation: none;
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    body {
+      transition: none;
+    }
+  }
+
+  /*
+    The site's only custom cursor: a standard arrow silhouette in the site's
+    own ink, outlined in the opposite tone so it reads over a light page and a
+    dark footer alike. Two files rather than one because a cursor image can't
+    respond to a CSS variable -- .dark on <html> picks between them.
+
+    Declared here and inherited, not with !important on a universal selector:
+    an inherited value loses to any element that declares its own, which is
+    what lets the interactive rule below take over. Those states are the
+    system's own pointer and help cursors, deliberately -- the arrow is the
+    only shape this site replaces.
+  */
+  html {
+    cursor:
+      url("/cursors/arrow-light.svg") 1 1,
+      default;
+  }
+
+  html.dark {
+    cursor:
+      url("/cursors/arrow-dark.svg") 1 1,
+      default;
+  }
+
+  a[href],
+  button,
+  summary,
+  [role="button"],
+  .marker,
+  .chart-mark {
+    cursor: pointer;
+  }
+
+  .data-note {
+    cursor: help;
+  }
+
+  button:disabled {
+    cursor: not-allowed;
+  }
+
+  /* Branded text selection. */
+  ::selection {
+    background-color: #5b8fa3;
+    color: #faf7f0;
+  }
+
+  /* Shared keyboard focus styling. */
+  .marker:focus-visible,
+  button:focus-visible,
+  .data-note:focus-visible {
+    outline: 2px solid rgb(var(--color-ink));
+    outline-offset: 2px;
+  }
+
+  .data-note:focus-visible {
+    border-radius: 2px;
+  }
+}
