--- /dev/null
+++ b/src/styles/slideshow.css
@@ -0,0 +1,623 @@
+/*
+  The slideshow deck: stage, panels, scroll containment and controls.
+*/
+
+@layer components {
+  /*
+    SLIDESHOW LAYOUT
+    ================
+
+    The stage. A horizontal flex track inside a clipped viewport: every panel is
+    `flex: 0 0 100%`, so each one has the full, correct, constant width whether
+    or not it happens to be the panel on screen. That is the load-bearing
+    property of this whole layout -- ResizeObserver keeps firing for off-stage
+    charts, useElementWidth keeps returning real pixels, and no chart ever has to
+    be re-measured because it was mounted into a box of zero width.
+
+    Panels scroll vertically inside themselves. The stage pages horizontally.
+    The two gestures never share an axis, which is why there is no swipe-to-page
+    binding anywhere in this build: a horizontal page gesture layered over a
+    vertical scroller is how a phone reader ends up feeling fought.
+  */
+  .slide-viewport {
+    position: relative;
+    overflow: hidden;
+    /* dvh, not vh: mobile browser chrome makes vh lie by roughly the height of
+       the address bar, which would put every panel's footer below the fold. */
+    height: calc(100dvh - var(--header-height));
+  }
+
+  .slide-track {
+    display: flex;
+    height: 100%;
+    will-change: transform;
+    transition: transform 520ms cubic-bezier(0.4, 0, 0.2, 1);
+  }
+
+  .slide-panel {
+    flex: 0 0 100%;
+    height: 100%;
+    /* The panel itself never scrolls. Overflow belongs one level in, to
+       .slide-scroll, so that the frame -- panel edges and footer -- holds still
+       at exactly one screen on every slide while only the content moves. When
+       the panel scrolled, a tall section (the snapshot grid, the divergence
+       panels) carried its footer away down the page with it and the deck's
+       height changed from slide to slide. */
+    overflow: hidden;
+    /* Off-stage panels fade rather than sitting at full strength just off the
+       edge -- with a fast pager the neighbour is briefly visible mid-transition
+       and a hard-edged one reads as a rendering fault. */
+    opacity: 1;
+    transition: opacity 320ms ease-out;
+  }
+
+  .slide-scroll {
+    min-height: 0;
+    flex: 1 1 auto;
+    overflow-y: auto;
+    /* Stops the inner scroll chaining out when it bottoms out, which on iOS
+       reads as the whole page bouncing. */
+    overscroll-behavior: contain;
+    /* Explicit. Setting overflow-y alone makes overflow-x compute to auto, and
+       the slide-enter animation translates sideways -- so the entrance was
+       briefly adding horizontal scrollable area to every panel. */
+    overflow-x: hidden;
+    /* Hidden, like the document's. The "more in this section" hint below is
+       what carries the affordance, and a scrollbar appearing on some slides and
+       not others is the visual inconsistency this whole pass is undoing. */
+    scrollbar-width: none;
+    display: flex;
+    flex-direction: column;
+  }
+
+  .slide-scroll::-webkit-scrollbar {
+    display: none;
+  }
+
+  /*
+    `> *`, not `> section`. Most sections render a <section>, but the sources
+    panel renders a <footer> -- so it fell through to the default flex:0 1 auto,
+    shrank below its own content, and clipped it with its own overflow-hidden.
+    That is the page that ended mid-list with no way to scroll to the rest: the
+    scroll container saw no overflow to scroll, because the child had already
+    hidden it.
+  */
+  .slide-scroll > * {
+    flex: 1 0 auto;
+  }
+
+  .slide-panel[data-active="false"] {
+    opacity: 0;
+  }
+
+  /*
+    height, not min-height. This was `min-height: 100%` -- a floor with no
+    ceiling -- so on any section taller than one screen the flex column simply
+    grew to fit its content. Nothing then overflowed .slide-scroll, so it never
+    scrolled (How Often and to Whom, Follow the Storm), and the footer was
+    pushed past the panel's own overflow:hidden clip and vanished (At a Glance,
+    and every other tall slide).
+
+    Bounding it here is what makes the whole arrangement work: the column is
+    exactly one panel tall, the footer takes the height it needs, and
+    .slide-scroll shrinks into what is left and scrolls its own content.
+    min-height:0 is the companion to that -- without it a flex child refuses to
+    shrink below its content and the ceiling is ignored again.
+  */
+  .slide-panel-inner {
+    display: flex;
+    height: 100%;
+    min-height: 0;
+    flex-direction: column;
+  }
+
+  /*
+    "There is more down there." The one affordance the slideshow has to add
+    back rather than merely preserve: the document scrollbar is hidden site-wide
+    because the canoe replaced it, and the panels hide theirs too, so nothing
+    else on screen says a panel continues past its bottom edge.
+
+    Sits outside the track so it stays put while the panel scrolls under it.
+  */
+  .slide-more {
+    position: absolute;
+    inset-inline: 0;
+    /* Clears the pinned footer rather than sitting under it. The footer is two
+       lines of button plus its own padding; 4.75rem is that, measured. */
+    bottom: 4.75rem;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.1rem;
+    padding-bottom: 0.6rem;
+    padding-top: 2.5rem;
+    color: rgb(var(--color-ink));
+    background: linear-gradient(
+      to top,
+      rgb(var(--color-sand)) 12%,
+      transparent
+    );
+    opacity: 0;
+    pointer-events: none;
+    transition: opacity 260ms ease-out;
+  }
+
+  .slide-more.is-visible {
+    opacity: 0.75;
+    animation: slide-more-nudge 2.4s ease-in-out infinite;
+  }
+
+  .slide-more-label {
+    font-size: 0.65rem;
+    letter-spacing: 0.14em;
+    text-transform: uppercase;
+    opacity: 0.7;
+  }
+
+  @keyframes slide-more-nudge {
+    0%,
+    100% {
+      transform: translateY(0);
+    }
+    50% {
+      transform: translateY(3px);
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .slide-more.is-visible {
+      animation: none;
+    }
+  }
+
+  /* A panel is one screen. The document's generous section padding wastes a
+     third of it, so it is tightened in slideshow layout only. */
+  .slide-viewport .slide-scroll > * {
+    padding-top: 1.75rem;
+    padding-bottom: 1.5rem;
+  }
+
+  /*
+    The map is the tallest single object on the site and it has no natural
+    ceiling -- it is sized from its own width, so on a wide window it grew past
+    a screen and took Explore the Pacific with it. Clamped to a share of the
+    panel so this slide is the same height as every other one.
+  */
+  .slide-viewport .map-frame svg {
+    /* width stays 100%, deliberately. An SVG with a viewBox has an aspect ratio
+       but no intrinsic width, so `width: auto` alongside an auto height lets
+       some engines fall back to the 300x150 replaced-element default. Keeping a
+       definite width and clamping the height lets preserveAspectRatio do the
+       scaling, and the ocean rect is drawn far past the viewBox so the letterbox
+       fills with sea rather than with a gap. */
+    height: auto;
+    max-height: 52vh;
+  }
+
+  /*
+    The footer is the header's twin at the other edge of the frame: pinned
+    rather than scrolling, so paging controls never have to be hunted for.
+    sticky, not fixed, because it belongs to the panel -- fixed would leave one
+    footer floating over all twelve of them.
+  */
+  .slide-footer {
+    position: sticky;
+    bottom: 0;
+    z-index: 20;
+    margin-top: auto;
+    /* Never shrinks. It is the fixed part of the frame -- if it gives up height
+       under pressure from a tall section, the footer's position stops being the
+       same on every slide, which is the whole point of it living out here
+       rather than inside the scrolling region. */
+    flex: 0 0 auto;
+  }
+
+  /*
+    FOLLOW THE STORM
+    ================
+
+    The one section that pages differently from the rest. Its left column is
+    the map, and it is pinned; only the right column scrolls, so the reader
+    moves the storm along its track without the map itself drifting up the
+    screen. That means the panel around it must not scroll at all -- otherwise
+    the outer scroll and the inner one compete for the same wheel gesture and
+    whichever wins is a matter of where the pointer happened to be.
+
+    So this section is height-locked to exactly one panel, the same as every
+    other slide, and the overflow is handed to the step column alone.
+  */
+  @media (min-width: 768px) {
+    .slide-viewport .slide-scroll > .journey-section {
+      display: flex;
+      min-height: 0;
+      flex: 1 1 auto;
+      flex-direction: column;
+      overflow: hidden;
+    }
+
+    .slide-viewport .journey-section > div {
+      display: flex;
+      min-height: 0;
+      flex: 1 1 auto;
+      flex-direction: column;
+    }
+
+    .slide-viewport .journey-split {
+      min-height: 0;
+      flex: 1 1 auto;
+      margin-top: 1.25rem;
+      /* The section carries md:items-start, which sizes both columns to their
+         own content -- so the step column's height:100% resolved against a row
+         as tall as the whole list and it never scrolled. An explicit single
+         row of minmax(0, 1fr), stretched, gives both columns exactly the
+         height that is available and no more. */
+      grid-template-rows: minmax(0, 1fr);
+      align-items: stretch;
+    }
+
+    .slide-viewport .journey-steps {
+      min-height: 0;
+      height: 100%;
+      overflow-y: auto;
+      /* Hidden like every other scrollbar on the site. This was left visible
+         at first, as the one place with no other affordance -- but a scrollbar
+         appearing on exactly one slide reads as a rendering fault rather than
+         an invitation, and the section's own line now says to scroll the right
+         column. */
+      scrollbar-width: none;
+      padding-right: 0.75rem;
+    }
+
+    /* A step is most of the column, so the -45% band can only ever hold one, and
+       the country being described sits centred against the map beside it. */
+    .slide-viewport .journey-steps::-webkit-scrollbar {
+      display: none;
+    }
+
+    .slide-viewport .journey-steps > li {
+      display: flex;
+      min-height: 78%;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    .slide-viewport .journey-steps > li:last-child {
+      min-height: 60%;
+    }
+  }
+
+  /* The map inside StormJourney is sticky against its scrolling ancestor. In
+     document layout that ancestor is the page, so it has to clear the fixed
+     header; in a panel the ancestor is the panel itself, which already starts
+     below the header, and the same offset would push the map a header's height
+     down the panel. */
+  .slide-viewport .journey-sticky {
+    /* Stacked layout: still sticky, but the panel already starts below the
+       header, so the document offset would push it a header's height down. */
+    top: 0.5rem;
+  }
+
+  @media (min-width: 768px) {
+    .slide-viewport .journey-sticky {
+      position: static;
+      display: flex;
+      height: 100%;
+      min-height: 0;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    .slide-viewport .journey-sticky svg {
+      min-height: 0;
+      max-height: 100%;
+    }
+  }
+
+  /*
+    SLIDE TRANSITIONS
+    =================
+
+    Two motions, doing different jobs. The track slides -- that is the deck
+    itself moving, and it is the same distance and the same curve every time so
+    the reader builds a sense of where they are. The contents then settle in
+    behind it, slightly later and over a shorter distance, which is what makes
+    a slide feel like it arrived somewhere rather than like a filmstrip pulled
+    past a window.
+
+    The enter animation restarts by itself on every activation without anything
+    being remounted: the selector matches only while data-active is true, so
+    going false -> true changes the computed animation-name from none and the
+    browser starts it again. That is the one animation trick that survives the
+    no-unmount rule this file is built on.
+  */
+  .slide-viewport[data-dir="forward"]
+    .slide-panel[data-active="true"]
+    .slide-scroll
+    > section {
+    animation: slide-enter-forward 560ms 90ms cubic-bezier(0.16, 0.84, 0.28, 1)
+      both;
+  }
+
+  .slide-viewport[data-dir="back"]
+    .slide-panel[data-active="true"]
+    .slide-scroll
+    > section {
+    animation: slide-enter-back 560ms 90ms cubic-bezier(0.16, 0.84, 0.28, 1)
+      both;
+  }
+
+  /* Sideways only. A vertical component inflates the scroll container's
+     scrollHeight while it runs, and the overflow hint measures exactly that --
+     so a slide with nothing below the fold still advertised more to read. */
+  @keyframes slide-enter-forward {
+    from {
+      opacity: 0;
+      transform: translate3d(34px, 0, 0);
+    }
+
+    to {
+      opacity: 1;
+      transform: translate3d(0, 0, 0);
+    }
+  }
+
+  @keyframes slide-enter-back {
+    from {
+      opacity: 0;
+      transform: translate3d(-34px, 0, 0);
+    }
+
+    to {
+      opacity: 1;
+      transform: translate3d(0, 0, 0);
+    }
+  }
+
+  /* The counter is the one part of the footer whose meaning changes on every
+     move, so it is the one part that acknowledges the move. */
+  .slide-panel[data-active="true"] .deck-count {
+    animation: deck-count-in 420ms 140ms cubic-bezier(0.16, 0.84, 0.28, 1) both;
+  }
+
+  @keyframes deck-count-in {
+    from {
+      opacity: 0;
+      transform: translateY(4px);
+    }
+
+    to {
+      opacity: 0.5;
+      transform: translateY(0);
+    }
+  }
+
+  /*
+    DECK BUTTONS
+    ============
+
+    One shared shape for Back and Next, so the two ends of the footer behave
+    identically under the pointer. The arrow leans the way it points on hover
+    and the whole control gives slightly under a press -- borrowed from the map
+    controls, which already did this, rather than inventing a second idiom.
+  */
+  .deck-btn {
+    display: flex;
+    min-width: 0;
+    align-items: center;
+    gap: 0.5rem;
+    border-radius: 0.5rem;
+    border-width: 1px;
+    padding: 0.5rem 0.75rem;
+    font-size: 0.875rem;
+    line-height: 1.25rem;
+    transition:
+      transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1),
+      background-color 180ms ease-out,
+      border-color 180ms ease-out;
+  }
+
+  .deck-btn:focus {
+    outline: none;
+  }
+
+  .deck-btn:focus-visible {
+    outline: 2px solid rgb(var(--color-accent));
+    outline-offset: 2px;
+  }
+
+  .deck-btn-back {
+    border-color: rgb(var(--color-ink) / 0.15);
+    text-align: left;
+  }
+
+  .deck-btn-back:hover {
+    border-color: rgb(var(--color-ink) / 0.35);
+    background-color: rgb(var(--color-surface) / 0.6);
+    transform: translateX(-2px);
+  }
+
+  .deck-btn-next {
+    border-color: rgb(var(--color-accent) / 0.4);
+    background-color: rgb(var(--color-accent) / 0.1);
+    font-weight: 500;
+    text-align: right;
+  }
+
+  .deck-btn-next:hover:not(.is-blocked) {
+    background-color: rgb(var(--color-accent) / 0.2);
+    transform: translateX(2px);
+  }
+
+  .deck-btn:active:not(.is-blocked) {
+    transform: scale(0.97);
+  }
+
+  .deck-btn-arrow {
+    opacity: 0.5;
+    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
+  }
+
+  .deck-btn-back:hover .deck-btn-arrow {
+    transform: translateX(-3px);
+  }
+
+  .deck-btn-next:hover:not(.is-blocked) .deck-btn-arrow {
+    transform: translateX(3px);
+  }
+
+  .deck-btn.is-blocked {
+    cursor: not-allowed;
+    border-style: dashed;
+    border-color: rgb(var(--color-ink) / 0.25);
+    background-color: transparent;
+    font-weight: 400;
+    opacity: 0.6;
+  }
+
+  /* The answer to pressing a button that will not move. A refusal the reader
+     can feel is better than one they have to infer from nothing happening. */
+  .deck-btn.is-refusing {
+    animation: deck-refuse 340ms cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
+  }
+
+  @keyframes deck-refuse {
+    10%,
+    90% {
+      transform: translateX(-2px);
+    }
+
+    20%,
+    80% {
+      transform: translateX(3px);
+    }
+
+    30%,
+    50%,
+    70% {
+      transform: translateX(-5px);
+    }
+
+    40%,
+    60% {
+      transform: translateX(5px);
+    }
+  }
+
+  /*
+    SELECTION FEEDBACK
+    ==================
+
+    Anything the reader can turn on and off: storm cards, map markers, the
+    nation legend. A press gives, a release springs back slightly past its
+    resting size, and the selected state settles. The spring is the same curve
+    as the map controls so the whole site presses the same way.
+  */
+  .press-target {
+    transition:
+      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
+      background-color 200ms ease-out,
+      border-color 200ms ease-out,
+      box-shadow 200ms ease-out;
+  }
+
+  .press-target:hover {
+    transform: translateY(-2px);
+  }
+
+  .press-target:active {
+    transform: translateY(0) scale(0.97);
+  }
+
+  .press-target[aria-pressed="true"] {
+    animation: press-confirm 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
+    box-shadow: 0 0 0 1px rgb(var(--color-accent) / 0.35);
+  }
+
+  @keyframes press-confirm {
+    0% {
+      transform: scale(0.96);
+    }
+
+    55% {
+      transform: scale(1.035);
+    }
+
+    100% {
+      transform: scale(1);
+    }
+  }
+
+  /* The selection strip arrives rather than appearing, since it turns up in a
+     header the reader is not looking at. */
+  .deck-status {
+    animation: deck-status-in 420ms cubic-bezier(0.16, 0.84, 0.28, 1) both;
+  }
+
+  @keyframes deck-status-in {
+    from {
+      opacity: 0;
+      transform: translateY(-6px);
+    }
+
+    to {
+      opacity: 1;
+      transform: translateY(0);
+    }
+  }
+
+  /*
+    Print is the one place the deck unrolls.
+    ========================================
+
+    Kept after the single-document reading mode was removed, and worth keeping:
+    it costs nothing, since no reader ever sees it, and a paginated deck cannot
+    be printed at all -- twelve slides would come out as one clipped page. This
+    is also the only remaining route to a searchable copy of the whole piece. A
+    judge who wants to check a roster claim can print to PDF and search that,
+    which matters because find-in-page now only reaches the slide on screen:
+    the off-stage panels are inert, and Chrome excludes inert content from it.
+
+    Nothing here needs a class on the tree, because nothing is conditionally
+    rendered -- all twelve sections are always in the DOM, so unrolling them is
+    purely a matter of undoing the layout.
+  */
+  @media print {
+    .slide-viewport {
+      overflow: visible !important;
+      height: auto !important;
+    }
+
+    .slide-track {
+      display: block !important;
+      transform: none !important;
+    }
+
+    .slide-panel,
+    .slide-panel-inner,
+    .slide-scroll {
+      display: block !important;
+      height: auto !important;
+      overflow: visible !important;
+      opacity: 1 !important;
+    }
+
+    .slide-panel[inert],
+    .slide-panel[aria-hidden="true"] {
+      display: block !important;
+    }
+
+    .slide-footer,
+    .slide-more {
+      display: none !important;
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .slide-track {
+      transition: none;
+    }
+    .slide-panel {
+      transition: none;
+    }
+  }
+}
diff --git a/src/styles/typography.css b/src/styles/typography.css
new file mode 100644
index 0000000..f934130
--- /dev/null
+++ b/src/styles/typography.css
@@ -0,0 +1,17 @@
+/*
+  Reading-column treatments, opted into per block.
+*/
+
+@layer components {
+  /*
+    Justified text only earns its keep in a real reading column, and only with
+    hyphenation -- unhyphenated justification opens rivers of white space, and
+    the narrower the column the worse it gets. Opt in per block rather than on
+    every <p>, so captions, chart notes and centred hero lines aren't dragged
+    into it.
+  */
+  .prose-column p {
+    text-align: justify;
+    hyphens: auto;
+  }
+}
